{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["@rsbuild/core/types", "node"],
    // Lets a route module import its generated types as `./+types/<name>`.
    // The plugin writes them to .react-router/types mirroring app/.
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": ["app", "*.ts", ".react-router/types/**/*"]
}
